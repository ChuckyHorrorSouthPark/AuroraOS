; AuroraOS Installer Template
; Nullsoft Scriptable Install System (NSIS) Configuration
; This file is used by the build system to create the Windows EXE installer

!include "MUI2.nsh"
!include "LogicLib.nsh"

; ===== CONFIGURATION =====
!define VERSION "1.0.0"
!define PRODUCT_NAME "AuroraOS"
!define COMPANY_NAME "AuroraOS Project"
!define INSTALLER_NAME "AuroraOS-${VERSION}"

; ===== INSTALLER PROPERTIES =====
Name "${PRODUCT_NAME} ${VERSION}"
OutFile "..\dist\${INSTALLER_NAME}.exe"
InstallDir "$PROGRAMFILES\${PRODUCT_NAME}"
ShowInstDetails show
ShowUninstDetails show

; Request application privileges for Windows Vista and higher
RequestExecutionLevel admin

; ===== MUI SETTINGS =====
!define MUI_ABORTWARNING
!define MUI_ICON "..\icons\auroraos.ico"
!define MUI_UNICON "..\icons\auroraos-uninstall.ico"
!define MUI_HEADERIMAGE
!define MUI_HEADERIMAGE_BITMAP "..\images\header.bmp"
!define MUI_WELCOMEFINISHPAGE_BITMAP "..\images\welcome.bmp"

; ===== PAGES =====
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH

!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH

; ===== LANGUAGE =====
!insertmacro MUI_LANGUAGE "English"

; ===== INSTALLER SECTIONS =====
Section "Install"
  SetOutPath "$INSTDIR"
  
  ; Copy all application files
  File /r "..\..\docs\*.*"
  File "..\..\..\README.md"
  
  ; Create bin directory
  CreateDirectory "$INSTDIR\bin"
  File "..\bin\Launch-AuroraOS.bat"
  
  ; Create uninstaller
  WriteUninstaller "$INSTDIR\uninstall.exe"
  
  ; Create Start Menu shortcuts
  CreateDirectory "$SMPROGRAMS\${PRODUCT_NAME}"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_NAME}\${PRODUCT_NAME} Documentation.lnk" "$INSTDIR\README.md"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_NAME}\System Architecture.lnk" "$INSTDIR\docs\SYSTEM_ARCHITECTURE.md"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_NAME}\Installation Guide.lnk" "$INSTDIR\docs\INSTALLATION_GUIDE.md"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_NAME}\Developer Guide.lnk" "$INSTDIR\docs\DEVELOPER_GUIDE.md"
  CreateShortcut "$SMPROGRAMS\${PRODUCT_NAME}\Uninstall.lnk" "$INSTDIR\uninstall.exe"
  
  ; Create Desktop shortcuts
  CreateShortcut "$DESKTOP\${PRODUCT_NAME}.lnk" "$INSTDIR\README.md"
  CreateShortcut "$DESKTOP\${PRODUCT_NAME} Documentation.lnk" "$INSTDIR\bin\Launch-AuroraOS.bat"
  
  ; Write registry entries for uninstaller
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}" \
             "DisplayName" "${PRODUCT_NAME} ${VERSION}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}" \
             "UninstallString" "$INSTDIR\uninstall.exe"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}" \
             "DisplayVersion" "${VERSION}"
  WriteRegStr HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}" \
             "Publisher" "${COMPANY_NAME}"
  
  SetOutPath "$INSTDIR"
  
SectionEnd

; ===== UNINSTALLER SECTION =====
Section "Uninstall"
  ; Remove Start Menu shortcuts
  RMDir /r "$SMPROGRAMS\${PRODUCT_NAME}"
  
  ; Remove Desktop shortcuts
  Delete "$DESKTOP\${PRODUCT_NAME}.lnk"
  Delete "$DESKTOP\${PRODUCT_NAME} Documentation.lnk"
  
  ; Remove installed files
  RMDir /r "$INSTDIR"
  
  ; Remove registry entries
  DeleteRegKey HKLM "Software\Microsoft\Windows\CurrentVersion\Uninstall\${PRODUCT_NAME}"
  
SectionEnd

; ===== FUNCTIONS =====
Function .onInstSuccess
  MessageBox MB_OK "${PRODUCT_NAME} ${VERSION} has been successfully installed.$\n$\nYou can now access the documentation through the Start Menu or Desktop shortcuts."
FunctionEnd

Function .onInstFailed
  MessageBox MB_ICONSTOP "Installation failed. Please check your permissions and try again."
FunctionEnd
